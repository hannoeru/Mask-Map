{
  "name": "vue-mask",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "serve": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint .",
    "deploy": "git push origin :gh-pages && git subtree push --prefix dist origin gh-pages",
    "test": "vitest run"
  },
  "dependencies": {
    "@vueuse/core": "15.0.0",
    "axios": "1.20.0",
    "leaflet": "1.9.4",
    "leaflet.locatecontrol": "0.90.1",
    "leaflet.markercluster": "1.5.3",
    "perfect-scrollbar": "1.5.6",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@types/leaflet": "1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "@unocss/eslint-plugin": "66.11.0",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "unocss": "66.11.0",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "katex": "0.19.0"
  }
}
